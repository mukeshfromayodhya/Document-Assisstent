# Backend configuration loaded from the project-root .env file.
# Development mode is for loopback use and permits an empty API token.
APP_ENV=development
API_ACCESS_TOKEN=
SESSION_COOKIE_SECURE=false
# Configure a model supported by your OpenAI-compatible provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
# Optional local data locations and retrieval tuning.
# AUTH_DB_PATH=storage/accounts.sqlite3
# VECTOR_DB_PATH=storage/vector_db
# VECTOR_DB_COLLECTION=documents
# RETRIEVAL_DEFAULT_TOP_K=5
# RETRIEVAL_MAX_TOP_K=50
# EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# EMBEDDING_DEVICE=auto
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_EXPECTED_DIMENSION=384
# PDF_MAX_PAGES=500
# OCR_DPI=240
# OCR_LANGUAGE=eng
# PDF_MAX_OCR_PIXELS=500000000
# For non-development use, set APP_ENV=production and provide a strong,
# ASCII API_ACCESS_TOKEN with at least 32 characters and no whitespace.
# Keep the same token in frontend/.env. Never commit .env files or secrets.
